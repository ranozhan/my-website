
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #eef2f7;
    color: #24344d;
    line-height: 1.6;
}

header {
    background-color: #102b4e;
    color: white;
    text-align: center;
    padding: 50px 20px;
}

header h1 {
    font-size: 36px;
    margin-bottom: 10px;
}

main {
    max-width: 800px;
    margin: 30px auto;
    padding: 20px;
}

section {
    background-color: white;
    padding: 25px;
    margin-bottom: 20px;
    border-radius: 12px;
}

section h2 {
    color: #163e68;
    margin-bottom: 10px;
}

footer {
    background-color: #102b4e;
    color: white;
    text-align: center;
    padding: 20px;
}
